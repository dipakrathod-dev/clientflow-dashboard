rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Data model:
    // clients/{clientId}: ownerUid (auth UID), name (1–100 chars), email
    // (valid email, <=254 chars), company (1–120 chars), budget (number >=0),
    // status (Active | Pending | Completed), createdAt and updatedAt (timestamps).
    // createdAt and ownerUid are immutable after creation.
    // projects/{projectId}: read-only documents scoped by ownerUid.

    function isAuthenticated() {
      return request.auth != null;
    }

    function owns(data) {
      return isAuthenticated() && data.ownerUid == request.auth.uid;
    }

    function hasValidClientFields(data) {
      return data.keys().hasAll([
          'ownerUid',
          'name',
          'email',
          'company',
          'budget',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'name',
          'email',
          'company',
          'budget',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.company is string
        && data.company.size() > 0
        && data.company.size() <= 120
        && data.budget is number
        && data.budget >= 0
        && data.status in ['Active', 'Pending', 'Completed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /clients/{clientId} {
      allow read, delete: if owns(resource.data);

      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && hasValidClientFields(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(resource.data)
        && hasValidClientFields(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /projects/{projectId} {
      allow read: if owns(resource.data);
    }

    // Deny every collection and operation not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
